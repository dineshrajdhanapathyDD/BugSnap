        <mxCell id="wfnote" value="Choice: valid? no &#8594; Fail (ValidationFailed) &#183; Retry + Catch &#8594; Fail (WorkflowFailed) &#183; Pass: BuildResult" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="915" y="235" width="420" height="40" as="geometry" />
